// Benchmark worker for bot drawings. Run with `npx wrangler dev -c scripts/bot-bench/wrangler.jsonc --port 8813`,
// then `node scripts/bot-bench/run.mjs`. Calls real models (Workers AI and AI Gateway), so it costs a little.
{
	"name": "wutizzit-bot-bench",
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"ai": { "binding": "AI" },
	"vars": { "AI_GATEWAY_ID": "default" },
}
