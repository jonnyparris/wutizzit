{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wutizzit",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},

	// Tailwind is compiled at build time (not via the Play CDN at runtime).
	// `wrangler dev` and `wrangler deploy` both run this first.
	"build": {
		"command": "npm run build:css",
		"watch_dir": ["src", "public/game.js", "public/index.html"]
	},

	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// `/room/ABC123` deep links fall back to index.html.
		"not_found_handling": "single-page-application",
		// Only API and WebSocket routes run the Worker. Everything else is served
		// straight from the asset cache without invoking the Worker.
		"run_worker_first": ["/rooms", "/rooms/*", "/api/*", "/mcp"]
	},

	"durable_objects": {
		"bindings": [
			{ "class_name": "GameRoomObject", "name": "GAME_ROOM" },
			{ "class_name": "GlobalStatsObject", "name": "GLOBAL_STATS" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["GameRoomObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["GlobalStatsObject"] }
	],

	// Workers AI powers the bot players. Third-party models (OpenAI, Anthropic, Google) go through
	// AI Gateway with Unified Billing; daily call budgets cap spend across all rooms.
	"ai": { "binding": "AI" },
	"vars": {
		"AI_GATEWAY_ID": "default",
		"AI_DAILY_FREE_CALLS": "20000",
		"AI_DAILY_PAID_CALLS": "1500",
		"AI_DAILY_CLEF_CALLS": "100000"
	},

	// Workers Rate Limiting binding: cheap, per-colo abuse protection on room
	// creation and joins. Keyed by client IP in src/index.ts.
	"ratelimits": [
		{ "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "JOIN_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
	]
}
